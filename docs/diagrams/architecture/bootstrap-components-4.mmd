sequenceDiagram
    participant User
    participant Modal
    participant Backdrop
    participant FocusTrap

    User->>Modal: show()
    Modal->>Backdrop: show()
    Modal->>Modal: adjustDialog()
    Modal->>FocusTrap: activate()
    Modal-->>User: shown event

    User->>Modal: hide()
    Modal->>FocusTrap: deactivate()
    Modal->>Backdrop: hide()
    Modal-->>User: hidden event
